# TRACULA dmrirc template — copy and configure once per subject.
#
# Save the configured file as:
#   /path/to/your/project/derivatives/batch/<SUBJECT_ID>/wm/tracula/<SUBJECT_ID>_dmrirc
#
# Every path and acquisition parameter below is study-specific. Verify it
# against your scanner protocol and FreeSurfer/TRACULA documentation before use.

set subject_id = 0001
setenv SUBJECTS_DIR /path/to/your/project/derivatives/batch/0001/wm/freesurfer
set dtroot = /path/to/your/project/derivatives/batch/0001/wm/freesurfer

# B0 correction: 0 = none, 1 = field map, 2 = reverse-polarity images.
set dob0 = 2
set subjlist = ( 0001 0001 )

# Point to your subject's diffusion source and list the forward/reverse-PE
# acquisitions in the order required by your TRACULA version.
set dcmroot = /path/to/your/diffusion_source/sub-0001
set dcmlist = ( dti/forward.dcm dti_reverse/reverse.dcm )

# Replace with acquisition-specific values.
set echospacing = YOUR_ECHO_SPACING_MS
set pedir = ( AP PA )
set epifactor = ( YOUR_EPI_FACTOR )
set doeddy = 1
set usethalnuc = 1

# 40 tracts: lh.cst and rh.cst are intentionally omitted.
set pathlist = (acomm cc.bodyc cc.bodyp cc.bodypf cc.bodypm cc.bodyt cc.genu cc.rostrum cc.splenium mcp lh.af rh.af lh.ar rh.ar lh.atr rh.atr lh.cbd rh.cbd lh.cbv rh.cbv lh.emc rh.emc lh.fat rh.fat lh.fx rh.fx lh.ilf rh.ilf lh.mlf rh.mlf lh.or rh.or lh.slf1 rh.slf1 lh.slf2 rh.slf2 lh.slf3 rh.slf3 lh.uf rh.uf)
